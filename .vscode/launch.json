{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}"
    },
    {
      "name": "Expo Debug (Attach)",
      "type": "expo",
      "request": "attach",
      "projectRoot": "${workspaceFolder}"
    },
    {
      "name": "Expo Launch (Android)",
      "type": "expo",
      "request": "launch",
      "platform": "android",
      "projectRoot": "${workspaceFolder}"
    }
  ]
}